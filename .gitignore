# ─── 操作系统 ──────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── IDE / 编辑器 ──────────────────────────────────────────────────────────────

# VS Code（保留 settings.json 和 extensions.json，忽略本地缓存）
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains（IntelliJ / Android Studio）
.idea/
*.iml
*.iws
*.ipr

# ─── Rust / Cargo（server/） ───────────────────────────────────────────────────

# 编译产物
server/target/

# Cargo 锁文件：库项目忽略，应用项目保留
# 本项目是可执行程序，保留 Cargo.lock
# server/Cargo.lock  ← 不忽略

# ─── Flutter / Dart（client/） ─────────────────────────────────────────────────

# Dart 工具缓存
client/flash_im/.dart_tool/
client/flash_im/.flutter-plugins
client/flash_im/.flutter-plugins-dependencies

# Flutter 构建产物
client/flash_im/build/

# pub 缓存（依赖由 pubspec.lock 管理，不提交本地缓存）
client/flash_im/.pub-cache/

# 代码生成产物（如果使用 build_runner）
client/flash_im/**/*.g.dart
client/flash_im/**/*.freezed.dart
client/flash_im/**/*.mocks.dart

# Flutter Web 构建
client/flash_im/web/

# Android 本地配置
client/flash_im/android/local.properties
client/flash_im/android/.gradle/
client/flash_im/android/key.properties

# iOS CocoaPods
client/flash_im/ios/Pods/
client/flash_im/ios/.symlinks/

# macOS CocoaPods
client/flash_im/macos/Pods/

# ─── 环境变量 / 密钥（绝对不能提交）──────────────────────────────────────────

.env
.env.*
*.pem
*.key
*.p12
*.jks
secrets.json
google-services.json
GoogleService-Info.plist

# ─── 日志 / 临时文件 ───────────────────────────────────────────────────────────

*.log
*.tmp
*.temp
*.swp
*.swo
